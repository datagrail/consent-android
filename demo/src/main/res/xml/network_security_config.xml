<?xml version="1.0" encoding="utf-8"?>
<!--
  Default (release) network security config: system CAs only, no cleartext.

  The DEBUG build overrides this with src/debug/res/xml/network_security_config.xml,
  which additionally trusts user-installed CAs so the TV demo can reach a local
  HTTPS test server using a developer cert (e.g. mkcert). Install your dev CA on
  the device/emulator (Settings > Security > Install certificate, or
  `adb push` + the CA-install flow) — nothing machine-specific is bundled here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
